@misc{wang2026jigsawcomm,
  author={Wang, C. and Li, Z. and Li, M. F. and Wen, W.},
  title={{JigsawComm}: Joint Semantic Feature Encoding and Transmission for Communication-Efficient Cooperative Perception},
  year={2026}, note={arXiv:2511.17843v2 (13 Mar 2026). Sparse encoder (L1 + learnable threshold kappa), FUE 1x1 conv utility u_i^l, cell utility U^l = sum m u - sum_{j!=i} m_i m_j min(u_i,u_j)/2, top-1 agent per cell then greedy by utility/cost to budget B; identical decision at every agent (V2I or V2V); meta utility maps 0.03 KB/agent; O(1) payload in N; OPV2V 0.92/0.82 at 44 KB total; Top-2 worse than Top-1 under max/attention fusion ("more is worse"); delay tested as feature staleness 0-500 ms; packet drop with ego fallback; cost uniform bytes per cell, no airtime, no deadline; code github.com/WiSeR-Lab/JigsawComm}}
@misc{bansal2026r2t,
  author={Bansal, A. and Gangwani, I.},
  title={Reason-to-Transmit: Deliberative Adaptive Communication for Cooperative Perception},
  year={2026}, note={arXiv:2603.20308 (19 Mar 2026), Synthetic Sciences. 2-layer transformer (0.26M) over 64 region tokens + agent context + neighbor-state token (positions/orientations, to estimate receiver visibility) + budget token; synthetic 64x64 BEV, N=4, K=20 objects, 128 B/region; oracle = ground-truth object content. Findings: any communication +58% AP over none; all selective policies within ~0.5 AP at 10% budget; R2T leads only under high occlusion (0.205 = oracle); "the fusion module matters more than the selection policy"}}
@misc{ma2026unseen,
