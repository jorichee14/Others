# Copy this file to ".env" (same folder) and fill in the values.
# NEVER commit the real .env — it holds your database password.
# (.gitignore in this folder already excludes it.)

# --- Synology user that owns the data folder (see README step 2) -------------
# Run `id your_user` over SSH and copy the numbers.
FORGEJO_UID=1026
FORGEJO_GID=100

# --- Database credentials (make up a strong password) ------------------------
POSTGRES_DB=forgejo
POSTGRES_USER=forgejo
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# --- Public address ----------------------------------------------------------
# BEFORE you have a domain (LAN-only testing), you can use the NAS IP:
#   FORGEJO_DOMAIN=192.168.1.50
#   FORGEJO_ROOT_URL=http://192.168.1.50:3000/
#
# AFTER you set up HTTPS + a domain (README step 6), use:
#   FORGEJO_DOMAIN=git.example.com
#   FORGEJO_ROOT_URL=https://git.example.com/
FORGEJO_DOMAIN=192.168.1.50
FORGEJO_ROOT_URL=http://192.168.1.50:3000/

# Host port for Git-over-SSH (Synology already uses 22, so use 2222).
FORGEJO_SSH_PORT=2222
