# Shared base: ROS 2 Humble, bag replay, and the TUM recorder every method uses.
FROM ros:humble-ros-base

SHELL ["/bin/bash", "-lc"]
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3-pip git build-essential cmake \
        ros-humble-rosbag2-storage-mcap \
        ros-humble-tf2-ros ros-humble-tf2-py \
    && rm -rf /var/lib/apt/lists/*
RUN pip3 install --no-cache-dir numpy

COPY docker/common/record_tum.py /opt/slambench/record_tum.py
COPY docker/common/entrypoint.sh /opt/slambench/entrypoint.sh
RUN chmod +x /opt/slambench/entrypoint.sh

ENV SLAM_RATE=1.0
ENTRYPOINT ["/opt/slambench/entrypoint.sh"]
