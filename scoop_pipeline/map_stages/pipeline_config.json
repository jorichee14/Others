{
  "dataset": {
    "bag": "~/workspaces/isaac_ros-dev/data/work/20260924/mapping_A/mirc_dataset_survey_1_mapping_20260924_merged",
    "traj": "traj_lidar_refined.txt",
    "machine": "mobile_1"
  },
   "boards": {
    "anchor": {
      "frame": "board",
      "squares_x": 9, "squares_y": 7,
      "square_len": 0.02, "marker_len": 0.015,
      "dictionary": "DICT_4X4_50",
      "instances": 2,
      "instance_names": ["anchor", "anchor_b"],
      "min_corners": 8, "max_reproj": 1.5, "min_ambiguity_ratio": 1.5
    },
    "rs_anchor": {
      "frame": "board_rs",
      "squares_x": 9,
      "squares_y": 7,
      "square_len": 0.025,
      "marker_len": 0.018,
      "dictionary": "DICT_5X5_50",
      "min_corners": 8,
      "max_reproj": 1.5,
      "min_ambiguity_ratio": 3.0
    }
  },
  "01_build_map": {
    "time_tol": 0.04,
    "deskew": true,
    "scan_voxel": 0.01,
    "final_voxel": 0.01,
    "lidar_min": 0.3,
    "lidar_max": 15.0,
    "flush_every": 200,
    "denoise":  { "enable": true, "nb": 30, "std": 3.0 },
     "colorize": { "enable": true, "img_stride": 1, "max_range": 10.0,
              "voxel": 0.00, "drop_gray": false },
    "flatten":  { "enable": false, "dist": 0.04, "min": 8000, "max_planes": 40 },

   "remove_dynamic": {
  "enable": true, "voxel": 0.15, "min_span_s": 1.0, "min_hits": 2, "save": true,
  "carve": { "enable": true, "ray_stride": 4, "scan_stride": 2,
             "max_range": 10.0, "grazing_margin": 0.03,
             "min_free": 5, "free_ratio": 1.0 }
},

   "detect_objects": {
  "enable": false,
  "model": "yolo11n-seg.pt",
  "device": "cuda:0",
  "conf": 0.25,
  "iou": 0.5,
  "imgsz": 640,
  "img_stride": 3,
  "voxel": 0.05,
  "max_range": 8.0,
  "classes": [],
  "exclude": ["person"],
  "bbox_shrink": 0.12,
  "mask_erode": 1,
  "depth_band": 1.0,
  "min_pixels": 40,
  "min_votes": 3,
  "min_ratio": 0.08,
  "cluster": { "eps": 0.15, "min_points": 30, "min_pts_keep": 60 },
  "structure_veto": {
    "enable": true, "voxel": 0.08, "plane_dist": 0.06,
    "min_area": 10.0, "max_planes": 25,
    "flush_tol": 0.03, "min_protrusion": 0.03
  },
  "save_layers": true, "save_per_object": false,
  "inventory": "objects_inventory.yaml"
},
    "anchor_camera_start": false
  },

  "06_cut": {
    "_note": "viewing copy only: run after 05, ceiling cut; nothing downstream reads it",
    "input": "map_final_{tag}_anchored.pcd",
    "output": "map_final_{tag}_anchored_noceil.pcd",
    "axis": "z",
    "floor": null,
    "ceil": null,
    "voxel": 0.05,
    "bins": 100
  },
  "05_anchor": {
    "input": "map_final_{tag}.pcd",
    "output": "map_final_{tag}_anchored.pcd",
    "frame_out": "anchor_frame.json",
    "skip_cloud": false,

    "boards_used": ["anchor", "rs_anchor"],
    "anchor_board": null,
    "board_axes": "ros",
    "board_origin": "center",
    "detect_period": 0.20,
    "section_gap": 3.0,
    "min_section_samples": 4,
    "assoc_radius": 0.40,
    "group_gap_factor": 2.5,

    "fuse": {
      "max_reproj_px": 1.0,
      "max_std_mm": 20.0,
      "max_section_disagree_mm": 50.0,
      "max_section_disagree_deg": 1.0
    },

    "time_tol": 0.1,
    "tf_max_gap": 0.2,
    "max_images": 0,
    "rectified": true,
    "map_frame": "map",
    "mapzed_frame": "map_zed",
    "zed_map_frame": "map_zed",
    "cam_frame": "zed_left_camera_optical_frame"
  },
  "07_build_cameras": {
    "anchor_frame": "anchor_frame.json",
    "output": "cameras_in_map.yaml",
    "map_frame": "map",
    "time_tol": 0.1,
    "cameras": [
      {
        "name": "realsense",
        "source": "board",
        "child_frame": "camera_color_optical_frame",
        "origin_frame": "map_realsense",
        "board": "rs_anchor",
        "bag": "/home/wicoms-robot/workspaces/isaac_ros-dev/20260828/mirc_dataset_mapping2_20260828_merged",
        "image_topic": "/camera/color/image_raw",
        "camera_info_topic": "/camera/color/camera_info",
        "rectified": false,
        "detect_target": 20,
        "static_tol_mm": 20.0,
        "img_stride": 1
      },
      {
        "name": "arducam",
        "source": "extrinsic_yaml",
        "child_frame": "arducam_optical_frame",
        "extrinsic_yaml": "extrinsic_arducam.yaml"
      }
    ]
  },
  "08_emit_tfs": {
    "input": "cameras_in_map.yaml",
    "bag_anchor": "session_anchor.json"
  },
 "03_init": {
  "_note": "runs: bag = dataset.bag; anchor_frame = the reference pass's when this pass has none; outputs in frames/",
  "anchor_frame": "anchor_frame.json",
  "output": "session_anchor.json",
  "script_out": "publish_session_tfs.sh",
  "map_frame": "map",

  "img_stride": 1,
  "max_images": 0,
  "static_tol_mm": 50.0,
  "moving_pose": "first",

  "sensors": [

    {
  "name": "zed",
  "board": "anchor",
  "source": "camera",
  "cam_frame": "zed_left_camera_optical_frame",
  "tf_child_frame": "zed_pose",
  "image_topic": "/mobile_1/zed/left/image_rect_color",
  "camera_info_topic": "/mobile_1/zed/left/camera_info",
  "rectified": true
  },
   {
   "name": "realsense",
   "board": "rs_anchor",
   "source": "camera",
   "cam_frame": "camera_color_optical_frame",
   "tf_child_frame": "rs_pose",
   "image_topic": "/mobile_2/color/image_raw",
     "camera_info_topic": "/mobile_2/color/camera_info",
      "rectified": false
    }
  ]
},
"09_build": {
  "_note": "bag = dataset.bag; traj = 04's LiDAR-ICP track; out = mapping/cloud_in_ref_<tag>.pcd",
  "topic": "/mobile_1/ouster/points",
  "voxel": 0.03, "range_min": 0.7, "range_max": 25.0,
  "t_start": null, "t_end": null,
  "min_count": 2, "keep_quality": true
},

"04_reference": {
    "_note": "every scan of the run registered to the anchored map, seeded by GLIM placed with 03's session anchor; ref_map = the reference pass's (or this pass's) map_final_<tag>_anchored.pcd",
    "name": "mobile_1_lidar",
    "points_topic": "/mobile_1/ouster/points",
    "anchor_cam": "zed",
    "out_dir": "reference_{tag}",
    "rounds": 2,
    "target_voxel": 0.05, "scan_voxel": 0.10, "plane_voxel": 0.4,
    "max_corr": [0.4, 0.2, 0.1], "min_corr": 200,
    "max_shift": 0.5, "max_rot_deg": 5.0
  },

 "10_publish": {
  "output_bag": "{tag}_best_poses",
  "map_frame": "map",
  "write_tf": true,
  "rate_hz": 0,
  "robots": [
    { "name": "mobile_1",
      "traj": "traj_mobile_1_lidar_in_cam.tum",
      "optical_frame": "zed_left_camera_optical_frame" }
  ]
}
}
