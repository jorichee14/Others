diff --git a/session_color.py b/session_color.py
new file mode 100644
index 0000000..e209198
--- /dev/null
+++ b/session_color.py
@@ -0,0 +1,65 @@
+"""One colour response per camera session, learned beside the texture.
+
+Two sensors photograph one building a month apart; one texture has to be
+read by both. Left alone, the texture settles on the average of the two
+colour responses and neither photograph is matched. Here each COLMAP camera
+id (one per sensor, one per session) owns an affine colour map, gain and
+bias per channel, applied to the render before the photometric loss. The
+lowest id is the reference and stays at identity, so the texture is kept in
+that session's colour; the others learn how they differ from it. Twelve
+numbers per extra session: nothing to overfit, and a direct measurement of
+how far apart the sensors sit.
+"""
+import os
+import torch
+import torch.nn as nn
+
+
+class SessionColor(nn.Module):
+    FILE = "session_color.pth"
+
+    def __init__(self, camera_ids, lr=1e-3):
+        super().__init__()
+        ids = sorted(set(int(i) for i in camera_ids))
+        self.reference = ids[0]
+        self.index = {i: k for k, i in enumerate(ids)}
+        self.gain = nn.Parameter(torch.ones(len(ids), 3, 1, 1, device="cuda"))
+        self.bias = nn.Parameter(torch.zeros(len(ids), 3, 1, 1, device="cuda"))
+        self.optimizer = torch.optim.Adam(self.parameters(), lr=lr) if len(ids) > 1 else None
+        print(f"[session colour] {len(ids)} session(s) {ids}; id {self.reference} is the reference")
+
+    def apply(self, image, cam):
+        """The render as this camera's session would have photographed it."""
+        k = self.index.get(int(cam.colmap_id))
+        if k is None or int(cam.colmap_id) == self.reference:
+            return image
+        return image * self.gain[k] + self.bias[k]
+
+    def step(self):
+        if self.optimizer is not None:
+            self.optimizer.step()
+            self.optimizer.zero_grad(set_to_none=True)
+
+    def describe(self):
+        for i, k in sorted(self.index.items()):
+            g, b = self.gain[k].flatten().tolist(), self.bias[k].flatten().tolist()
+            tag = " (reference)" if i == self.reference else ""
+            print(f"[session colour] id {i}{tag}: gain {g[0]:.3f} {g[1]:.3f} {g[2]:.3f}"
+                  f"  bias {b[0]:+.3f} {b[1]:+.3f} {b[2]:+.3f}")
+
+    def save(self, model_path):
+        torch.save({"ids": sorted(self.index, key=self.index.get), "gain": self.gain.detach().cpu(),
+                    "bias": self.bias.detach().cpu()}, os.path.join(model_path, self.FILE))
+
+    @classmethod
+    def load(cls, model_path):
+        path = os.path.join(model_path, cls.FILE)
+        if not os.path.exists(path):
+            return None
+        state = torch.load(path)
+        model = cls(state["ids"])
+        with torch.no_grad():
+            model.gain.copy_(state["gain"].cuda())
+            model.bias.copy_(state["bias"].cuda())
+        model.describe()
+        return model
