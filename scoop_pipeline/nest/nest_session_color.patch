diff --git a/session_color.py b/session_color.py
new file mode 100644
index 0000000..b0ba17a
--- /dev/null
+++ b/session_color.py
@@ -0,0 +1,106 @@
+"""Colour responses learned beside the texture: one per session, one per image.
+
+Two sensors photograph one building a month apart; one texture has to be
+read by both. Left alone, the texture settles on the average of the two
+colour responses and matches neither. Each COLMAP camera id (one per
+sensor, one per session) owns an affine colour map, gain and bias per
+channel, applied to the render before the photometric loss. The lowest id
+is the reference and stays at identity, so the texture is kept in that
+session's colour; the others learn how they differ from it.
+
+Within a session the camera's auto-exposure drifts from frame to frame.
+With `image_color` on, every training image also owns its own gain and
+bias, so the flicker is absorbed there instead of being painted into the
+texture. Only the session term is known for a view the model never saw, so
+evaluation and novel views apply the session term alone: a clean, steady
+exposure along a flythrough, and an honest held-out number.
+"""
+import os
+import torch
+import torch.nn as nn
+
+
+class SessionColor(nn.Module):
+    FILE = "session_color.pth"
+
+    def __init__(self, cameras, per_image=False, lr=1e-3, image_lr=1e-3):
+        """cameras: the training cameras (colmap_id, image_name) or a saved state's lists."""
+        super().__init__()
+        ids = sorted(set(int(c.colmap_id) for c in cameras))
+        self.reference = ids[0]
+        self.index = {i: k for k, i in enumerate(ids)}
+        self.gain = nn.Parameter(torch.ones(len(ids), 3, 1, 1, device="cuda"))
+        self.bias = nn.Parameter(torch.zeros(len(ids), 3, 1, 1, device="cuda"))
+        groups = [{"params": [self.gain, self.bias], "lr": lr}] if len(ids) > 1 else []
+        self.names = {}
+        if per_image:
+            self.names = {c.image_name: k for k, c in enumerate(cameras)}
+            self.igain = nn.Parameter(torch.ones(len(self.names), 3, 1, 1, device="cuda"))
+            self.ibias = nn.Parameter(torch.zeros(len(self.names), 3, 1, 1, device="cuda"))
+            groups.append({"params": [self.igain, self.ibias], "lr": image_lr})
+        self.optimizer = torch.optim.Adam(groups) if groups else None
+        print(f"[session colour] {len(ids)} session(s) {ids}; id {self.reference} is the reference"
+              + (f"; {len(self.names)} per-image terms" if self.names else ""))
+
+    def apply(self, image, cam, training=False):
+        """The render as this camera would have photographed it.
+
+        training=True adds the image's own term (a training image only);
+        otherwise only the session term, which is all a new view can know.
+        """
+        k = self.index.get(int(cam.colmap_id))
+        if k is not None and int(cam.colmap_id) != self.reference:
+            image = image * self.gain[k] + self.bias[k]
+        if training and self.names:
+            j = self.names.get(cam.image_name)
+            if j is not None:
+                image = image * self.igain[j] + self.ibias[j]
+        return image
+
+    def step(self):
+        if self.optimizer is not None:
+            self.optimizer.step()
+            self.optimizer.zero_grad(set_to_none=True)
+
+    def describe(self):
+        for i, k in sorted(self.index.items()):
+            g, b = self.gain[k].flatten().tolist(), self.bias[k].flatten().tolist()
+            tag = " (reference)" if i == self.reference else ""
+            print(f"[session colour] id {i}{tag}: gain {g[0]:.3f} {g[1]:.3f} {g[2]:.3f}"
+                  f"  bias {b[0]:+.3f} {b[1]:+.3f} {b[2]:+.3f}")
+        if self.names:
+            lum = (self.igain.detach().mean(dim=(1, 2, 3)) + self.ibias.detach().mean(dim=(1, 2, 3))).cpu()
+            print(f"[session colour] per-image exposure (gain+bias, grey): "
+                  f"10% {lum.quantile(0.1):.3f}  median {lum.median():.3f}  90% {lum.quantile(0.9):.3f}")
+
+    def save(self, model_path):
+        state = {"ids": sorted(self.index, key=self.index.get), "gain": self.gain.detach().cpu(),
+                 "bias": self.bias.detach().cpu()}
+        if self.names:
+            state["names"] = sorted(self.names, key=self.names.get)
+            state["igain"], state["ibias"] = self.igain.detach().cpu(), self.ibias.detach().cpu()
+        torch.save(state, os.path.join(model_path, self.FILE))
+
+    @classmethod
+    def load(cls, model_path):
+        path = os.path.join(model_path, cls.FILE)
+        if not os.path.exists(path):
+            return None
+        state = torch.load(path)
+
+        class Stub:                                   # what __init__ reads of a camera
+            def __init__(self, colmap_id, image_name):
+                self.colmap_id, self.image_name = colmap_id, image_name
+        names = state.get("names")
+        cameras = ([Stub(i, f"#session{i}") for i in state["ids"]] if names is None
+                   else [Stub(state["ids"][0], n) for n in names] + [Stub(i, f"#session{i}") for i in state["ids"][1:]])
+        model = cls(cameras, per_image=names is not None)
+        with torch.no_grad():
+            model.gain.copy_(state["gain"].cuda())
+            model.bias.copy_(state["bias"].cuda())
+            if names is not None:
+                model.names = {n: k for k, n in enumerate(names)}
+                model.igain = nn.Parameter(state["igain"].cuda())
+                model.ibias = nn.Parameter(state["ibias"].cuda())
+        model.describe()
+        return model
