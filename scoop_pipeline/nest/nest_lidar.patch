+def lidar_depth_of(cam, source_path):
+    """The LiDAR depth map beside this image, in metres on the GPU, cached on the camera.
+
+    The scene builder writes <scene>/depths/<name>.png as 8-bit grey + alpha:
+    grey = d / 20 below 10 m and 1 - 5 / d beyond, alpha 0 where the map
+    had no return. Decoded once per camera and kept.
+    """
+    if cam.depth_map is not None:
+        return cam.depth_map if cam.depth_map is not False else None
+    path = os.path.join(source_path, "depths", os.path.splitext(cam.image_name)[0] + ".png")
+    if not os.path.exists(path):
+        cam.depth_map = False
+        return None
+    import cv2
+    png = cv2.imread(path, cv2.IMREAD_UNCHANGED)
+    if png is None:
+        cam.depth_map = False
+        return None
+    grey = png[:, :, 0].astype(np.float32) / 255.0 if png.ndim == 3 else png.astype(np.float32) / 255.0
+    metres = np.where(grey < 0.5, 20.0 * grey, 5.0 / np.maximum(1.0 - grey, 1e-6))
+    valid = png[:, :, 3] > 0 if png.ndim == 3 and png.shape[2] == 4 else grey > 0
+    metres[~valid] = 0.0
+    depth = torch.from_numpy(metres)[None].cuda()
+    if depth.shape[1:] != (cam.image_height, cam.image_width):
+        depth = torch.nn.functional.interpolate(depth[None], (cam.image_height, cam.image_width),
+                                                mode="nearest")[0]
+    cam.depth_map = depth
+    return depth
+
