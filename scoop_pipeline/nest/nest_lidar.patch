+def quaternions_with_normal(n):
+    """(N, 4) unit quaternions (w, x, y, z) whose rotation's third axis is n.
+
+    Build an orthonormal frame [t1, t2, n] per point and convert it, the
+    same way build_rotation reads a quaternion back, so the surfel's normal
+    comes out exactly n.
+    """
+    n = n / n.norm(dim=1, keepdim=True).clamp_min(1e-9)
+    helper = torch.where((n[:, 2:3].abs() < 0.9), torch.tensor([[0.0, 0.0, 1.0]], device=n.device),
+                         torch.tensor([[1.0, 0.0, 0.0]], device=n.device)).expand_as(n)
+    t1 = torch.cross(helper, n, dim=1)
+    t1 = t1 / t1.norm(dim=1, keepdim=True).clamp_min(1e-9)
+    t2 = torch.cross(n, t1, dim=1)
+    R = torch.stack([t1, t2, n], dim=2)                      # columns: t1, t2, n
+    m00, m01, m02 = R[:, 0, 0], R[:, 0, 1], R[:, 0, 2]
+    m10, m11, m12 = R[:, 1, 0], R[:, 1, 1], R[:, 1, 2]
+    m20, m21, m22 = R[:, 2, 0], R[:, 2, 1], R[:, 2, 2]
+    trace = m00 + m11 + m22
+    q = torch.zeros((len(n), 4), device=n.device)
+    # Shepperd's method: pick the largest of the four candidates per row.
+    c0 = 1 + trace
+    c1 = 1 + m00 - m11 - m22
+    c2 = 1 - m00 + m11 - m22
+    c3 = 1 - m00 - m11 + m22
+    choice = torch.stack([c0, c1, c2, c3], dim=1).argmax(dim=1)
+    s = torch.sqrt(c0.clamp_min(1e-12)) * 2
+    q0 = torch.stack([0.25 * s, (m21 - m12) / s, (m02 - m20) / s, (m10 - m01) / s], dim=1)
+    s = torch.sqrt(c1.clamp_min(1e-12)) * 2
+    q1 = torch.stack([(m21 - m12) / s, 0.25 * s, (m01 + m10) / s, (m02 + m20) / s], dim=1)
+    s = torch.sqrt(c2.clamp_min(1e-12)) * 2
+    q2 = torch.stack([(m02 - m20) / s, (m01 + m10) / s, 0.25 * s, (m12 + m21) / s], dim=1)
+    s = torch.sqrt(c3.clamp_min(1e-12)) * 2
+    q3 = torch.stack([(m10 - m01) / s, (m02 + m20) / s, (m12 + m21) / s, 0.25 * s], dim=1)
+    for k, cand in enumerate((q0, q1, q2, q3)):
+        q[choice == k] = cand[choice == k]
+    return q / q.norm(dim=1, keepdim=True)
+
