<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>wifi_monitor</name>
  <version>0.1.0</version>
  <description>
    ROS 2 node that monitors a wireless interface and publishes RSSI, SNR,
    link quality, bit rate and RX/TX traffic statistics as a WifiLinkStatus
    message plus diagnostics.
  </description>
  <maintainer email="jorichloq@gmail.com">jorichee14</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>wifi_monitor_msgs</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
